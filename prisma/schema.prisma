// Estrutura do banco de dados. Cada mudança aqui vira uma migração em
// prisma/migrations, aplicada automaticamente na publicação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Um usuário pode ter mais de um perfil (ex.: fornecedora que também compra).
enum Perfil {
  administradora
  ajudante
  cliente
  fornecedora
}

model Usuario {
  id             String          @id @default(cuid())
  nome           String          @db.VarChar(120)
  email          String          @unique @db.VarChar(191)
  senhaHash      String          @map("senha_hash") @db.VarChar(100)
  ativo          Boolean         @default(true)
  ultimoAcessoEm DateTime?       @map("ultimo_acesso_em")
  criadoEm       DateTime        @default(now()) @map("criado_em")
  atualizadoEm   DateTime        @updatedAt @map("atualizado_em")
  perfis         UsuarioPerfil[]
  /// Ficha de cliente ligada a esta conta (quem tem o perfil cliente).
  cliente        Cliente?
  linksDeSenha   LinkDeSenha[]
  /// Ficha de fornecedora ligada a esta conta (quem tem o perfil fornecedora).
  fornecedora    Fornecedora?
  candidatura    Candidatura?

  @@map("usuarios")
}

model UsuarioPerfil {
  usuarioId String   @map("usuario_id")
  perfil    Perfil
  criadoEm  DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, perfil])
  @@index([perfil])
  @@map("usuario_perfis")
}

/// Numeração que nunca volta atrás: um código usado não é reaproveitado, nem
/// depois de excluído. Chaves: "fornecedora" e "peca:<prefixo>" (ex.: "peca:F06").
model Sequencia {
  chave  String @id @db.VarChar(40)
  ultimo Int

  @@map("sequencias")
}

model Fornecedora {
  id                      String               @id @default(cuid())
  numero                  Int                  @unique
  /// "F" + número com pelo menos 2 dígitos (F01, F48, F100). Nunca faz parte do nome.
  codigo                  String               @unique @db.VarChar(10)
  nome                    String               @db.VarChar(160)
  telefone                String?              @db.VarChar(40)
  email                   String?              @db.VarChar(191)
  /// CPF ou CNPJ: só a administradora vê.
  documento               String?              @db.VarChar(30)
  pix                     String?              @db.VarChar(191)
  endereco                String?              @db.VarChar(255)
  cep                     String?              @db.VarChar(15)
  cidade                  String?              @db.VarChar(100)
  estado                  String?              @db.VarChar(60)
  pais                    String?              @db.VarChar(60)
  /// Pontos-base: 4000 = 40%.
  percentualRepassePadrao Int                  @default(4000) @map("percentual_repasse_padrao")
  ativa                   Boolean              @default(true)
  /// Conta de acesso à área da fornecedora.
  usuarioId               String?              @unique @map("usuario_id")
  /// Quando aceitou o acordo de consignação, e qual versão do texto.
  termosAceitosEm         DateTime?            @map("termos_aceitos_em")
  termosVersao            String?              @map("termos_versao") @db.VarChar(20)
  /// Quando viu o "Parabéns" (passo 3) e entrou na área de verdade.
  boasVindasEm            DateTime?            @map("boas_vindas_em")
  criadoEm                DateTime             @default(now()) @map("criado_em")
  atualizadoEm            DateTime             @updatedAt @map("atualizado_em")
  usuario                 Usuario?             @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  pecas                   Peca[]
  candidatura             Candidatura?
  propostas               PecaProposta[]
  devolucoes              Devolucao[]
  convites                ConviteFornecedora[]

  @@map("fornecedoras")
}

enum TipoPeca {
  consignada
  loja
}

enum StatusPeca {
  rascunho
  publicada
  reservada
  vendida
  na_sacolinha
  enviada
  retirada
  devolvida
  /// A fornecedora pediu a peça de volta: sai da vitrine até a Salty devolver.
  devolucao_pedida
  doada
  baixa
}

enum Genero {
  masculino
  feminino
  unissex
}

/// Qual regra de "grupo sugerido" o grupo de WhatsApp atende (CLAUDE.md, "Grupos de WhatsApp").
enum PapelGrupo {
  masculino
  feminino
  promocao
  acessorios
  calcados
}

/// Grupo de WhatsApp onde a Salty divulga as peças. A lista é editável no painel.
model GrupoWhatsapp {
  id       String      @id @default(cuid())
  nome     String      @unique @db.VarChar(60)
  /// Marca do grupo no link do post (?g=meninas). Não muda quando o nome muda, para os links antigos continuarem contando.
  codigo   String      @unique @db.VarChar(40)
  papel    PapelGrupo?
  ordem    Int         @default(0)
  /// Grupo desativado some das escolhas, mas continua nas vendas que já o têm.
  ativo    Boolean     @default(true)
  criadoEm DateTime    @default(now()) @map("criado_em")
  vendas   Venda[]
  pedidos  Pedido[]

  @@map("grupos_whatsapp")
}

enum Conservacao {
  nova_com_etiqueta
  seminova
  com_marcas_de_uso
}

model Peca {
  id                String          @id @default(cuid())
  /// "<código da fornecedora>-<5 dígitos>" ou "SB-<5 dígitos>" para peças da loja.
  codigo            String          @unique @db.VarChar(20)
  /// Código do Notion, guardado para busca.
  codigoAntigo      String?         @map("codigo_antigo") @db.VarChar(20)
  nome              String          @db.VarChar(160)
  tipo              TipoPeca
  fornecedoraId     String?         @map("fornecedora_id")
  /// Pontos-base (4000 = 40%). Vazio nas peças da loja, que não têm repasse.
  percentualRepasse Int?            @map("percentual_repasse")
  precoCentavos     Int             @map("preco_centavos")
  custoCentavos     Int?            @map("custo_centavos")
  quantidade        Int             @default(1)
  tamanho           String?         @db.VarChar(20)
  genero            Genero?
  conservacao       Conservacao?
  /// Nota da peça, de 5 a 10, escolhida pela administradora. Vai no post dos grupos.
  nota              Int?            @db.TinyInt
  variacao          String?         @db.VarChar(80)
  marca             String?         @db.VarChar(80)
  cor               String?         @db.VarChar(80)
  /// Antigo campo de texto livre, substituído por `categorias`. Fica até a próxima limpeza do banco.
  categoria         String?         @db.VarChar(80)
  medidas           String?         @db.VarChar(160)
  descricao         String?         @db.Text
  status            StatusPeca      @default(rascunho)
  /// "Não listado": à venda só para quem tem o link (não aparece na vitrine). Vale com status publicada.
  naoListada        Boolean         @default(false) @map("nao_listada")
  dataEntrada       DateTime        @map("data_entrada") @db.Date
  criadoEm          DateTime        @default(now()) @map("criado_em")
  atualizadoEm      DateTime        @updatedAt @map("atualizado_em")
  fornecedora       Fornecedora?    @relation(fields: [fornecedoraId], references: [id])
  fotos             FotoPeca[]
  categorias        PecaCategoria[]
  itensVendidos     ItemVenda[]
  itensPedido       ItemPedido[]
  favoritos         Favorito[]
  proposta          PecaProposta?
  devolucoes        Devolucao[]

  @@index([codigoAntigo])
  @@index([status])
  @@index([fornecedoraId])
  @@map("pecas")
}

model FotoPeca {
  id       String   @id @default(cuid())
  pecaId   String   @map("peca_id")
  /// Caminho dentro da pasta de fotos da VPS (FOTOS_DIR).
  arquivo  String   @db.VarChar(191)
  ordem    Int      @default(0)
  criadoEm DateTime @default(now()) @map("criado_em")
  peca     Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@index([pecaId, ordem])
  @@map("fotos_pecas")
}

model Cliente {
  id           String     @id @default(cuid())
  nome         String     @db.VarChar(160)
  telefone     String?    @db.VarChar(40)
  email        String?    @db.VarChar(191)
  /// Só a administradora vê.
  cpf          String?    @db.VarChar(20)
  endereco     String?    @db.VarChar(255)
  cep          String?    @db.VarChar(15)
  cidade       String?    @db.VarChar(100)
  estado       String?    @db.VarChar(60)
  pais         String?    @db.VarChar(60)
  observacao   String?    @db.Text
  /// Conta de acesso ao site (área do cliente), criada pela cliente ou pela loja.
  usuarioId    String?    @unique @map("usuario_id")
  criadoEm     DateTime   @default(now()) @map("criado_em")
  atualizadoEm DateTime   @updatedAt @map("atualizado_em")
  usuario      Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  vendas       Venda[]
  pedidos      Pedido[]
  criancas     Crianca[]
  favoritos    Favorito[]

  @@map("clientes")
}

/// Peça marcada com a estrela pela cliente. A loja vê quem favoritou cada peça.
model Favorito {
  clienteId String   @map("cliente_id")
  pecaId    String   @map("peca_id")
  criadoEm  DateTime @default(now()) @map("criado_em")
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  peca      Peca     @relation(fields: [pecaId], references: [id], onDelete: Cascade)

  @@id([clienteId, pecaId])
  @@index([pecaId])
  @@map("favoritos")
}

/// Link para a pessoa criar (ou trocar) a senha, gerado pela loja no painel e
/// enviado pelo WhatsApp. Só o hash do código fica guardado.
model LinkDeSenha {
  id         String    @id @default(cuid())
  usuarioId  String    @map("usuario_id")
  codigoHash String    @unique @map("codigo_hash") @db.VarChar(64)
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("links_de_senha")
}

/// Filhos (ou outras crianças) da cliente, para marketing e pós-venda.
model Crianca {
  id         String    @id @default(cuid())
  clienteId  String    @map("cliente_id")
  nome       String    @db.VarChar(80)
  nascimento DateTime? @db.Date
  /// feminino (menina) ou masculino (menino).
  sexo       Genero?
  criadoEm   DateTime  @default(now()) @map("criado_em")
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@map("criancas")
}

enum CanalVenda {
  site
  whatsapp_privado
  grupo_whatsapp
  instagram
  loja
  bag
}

enum FormaPagamento {
  pix
  cartao
  dinheiro
  credito_fornecedora
}

model Venda {
  id               String          @id @default(cuid())
  data             DateTime        @db.Date
  clienteId        String?         @map("cliente_id")
  canal            CanalVenda
  /// Grupo de WhatsApp da venda, quando o canal é grupo_whatsapp.
  grupo            String?         @db.VarChar(60)
  /// Grupo da venda (pelo canal ou pelo link do post), para medir as vendas por grupo.
  grupoId          String?         @map("grupo_id")
  formaPagamento   FormaPagamento? @map("forma_pagamento")
  subtotalCentavos Int             @map("subtotal_centavos")
  descontoCentavos Int             @default(0) @map("desconto_centavos")
  totalCentavos    Int             @map("total_centavos")
  /// De onde veio a venda antiga, quando importada (ex.: "Notion: ka - liquida").
  origem           String?         @db.VarChar(191)
  criadoEm         DateTime        @default(now()) @map("criado_em")
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  grupoWhatsapp    GrupoWhatsapp?  @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  itens            ItemVenda[]
  pedido           Pedido?

  @@index([data])
  @@map("vendas")
}

/// Repasse, desconto e lucro ficam gravados em cada item no momento da venda,
/// para que uma mudança futura de percentual não altere o histórico.
model ItemVenda {
  id                    String    @id @default(cuid())
  vendaId               String    @map("venda_id")
  pecaId                String    @map("peca_id")
  quantidade            Int       @default(1)
  precoUnitarioCentavos Int       @map("preco_unitario_centavos")
  descontoCentavos      Int       @default(0) @map("desconto_centavos")
  valorPagoCentavos     Int       @map("valor_pago_centavos")
  percentualRepasse     Int?      @map("percentual_repasse")
  repasseCentavos       Int       @map("repasse_centavos")
  custoCentavos         Int?      @map("custo_centavos")
  lucroCentavos         Int       @map("lucro_centavos")
  /// A fornecedora já recebeu o repasse deste item.
  repasseRecebido       Boolean   @default(false) @map("repasse_recebido")
  repasseRecebidoEm     DateTime? @map("repasse_recebido_em") @db.Date
  venda                 Venda     @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  peca                  Peca      @relation(fields: [pecaId], references: [id])

  @@index([vendaId])
  @@index([pecaId])
  @@map("itens_venda")
}

/// Lista de categorias que a administradora mantém no painel. Uma peça pode ter várias.
model Categoria {
  id        String          @id @default(cuid())
  nome      String          @unique @db.VarChar(60)
  ordem     Int             @default(0)
  /// Categoria desativada some do cadastro, mas continua nas peças que já a têm.
  ativa     Boolean         @default(true)
  criadoEm  DateTime        @default(now()) @map("criado_em")
  pecas     PecaCategoria[]
  propostas PecaProposta[]

  @@map("categorias")
}

model PecaCategoria {
  pecaId      String    @map("peca_id")
  categoriaId String    @map("categoria_id")
  peca        Peca      @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@id([pecaId, categoriaId])
  @@index([categoriaId])
  @@map("pecas_categorias")
}

/// Situação do pedido feito no site. "reservado" segura as peças por 15 minutos.
enum StatusPedido {
  reservado
  expirado
  cancelado
  pago
}

/// Pedido montado no carrinho do site e enviado pelo WhatsApp.
model Pedido {
  id              String         @id @default(cuid())
  /// Número curto que a cliente cita no WhatsApp (tabela sequencias, chave "pedido").
  numero          Int            @unique
  nomeCliente     String         @map("nome_cliente") @db.VarChar(120)
  /// WhatsApp que a cliente digitou ao fechar o pedido (a administradora pode corrigir).
  telefoneCliente String?        @map("telefone_cliente") @db.VarChar(40)
  /// Cliente do cadastro ligada ao pedido pela administradora; passa para a venda.
  clienteId       String?        @map("cliente_id")
  observacao      String?        @db.Text
  /// Grupo de WhatsApp de onde a cliente veio (link do post com ?g=...).
  grupoId         String?        @map("grupo_id")
  status          StatusPedido   @default(reservado)
  /// Até quando as peças ficam reservadas.
  reservadoAte    DateTime       @map("reservado_ate")
  totalCentavos   Int            @map("total_centavos")
  /// Venda criada ao confirmar o pagamento.
  vendaId         String?        @unique @map("venda_id")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")
  itens           ItemPedido[]
  venda           Venda?         @relation(fields: [vendaId], references: [id])
  cliente         Cliente?       @relation(fields: [clienteId], references: [id])
  grupo           GrupoWhatsapp? @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  @@index([status, reservadoAte])
  @@map("pedidos")
}

model ItemPedido {
  pedidoId      String @map("pedido_id")
  pecaId        String @map("peca_id")
  /// Ordem em que a cliente escolheu as peças.
  ordem         Int    @default(0)
  /// Preço da peça no momento do pedido.
  precoCentavos Int    @map("preco_centavos")
  pedido        Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  peca          Peca   @relation(fields: [pecaId], references: [id])

  @@id([pedidoId, pecaId])
  @@index([pecaId])
  @@map("itens_pedido")
}

/// Etapas de quem quer ser fornecedora (página "Seja uma fornecedora").
enum EtapaCandidatura {
  /// Passo 1 enviado: aguardando a curadoria.
  enviada
  /// Curadoria aprovou: a pessoa tem acesso e faz o passo 2 na área dela.
  aprovada
  /// Passo 2 feito (peças e acordo): a Salty entra em contato para efetivar.
  acordo_aceito
  /// Passo 3: virou fornecedora (tem código F..).
  efetivada
  recusada
}

model Candidatura {
  id             String           @id @default(cuid())
  nome           String           @db.VarChar(160)
  email          String           @db.VarChar(191)
  telefone       String           @db.VarChar(40)
  endereco       String           @db.VarChar(255)
  cep            String?          @db.VarChar(15)
  cidade         String?          @db.VarChar(100)
  estado         String?          @db.VarChar(60)
  etapa          EtapaCandidatura @default(enviada)
  /// Anotação da curadoria (só o painel vê).
  observacao     String?          @db.Text
  acordoAceitoEm DateTime?        @map("acordo_aceito_em")
  acordoVersao   String?          @map("acordo_versao") @db.VarChar(20)
  usuarioId      String?          @unique @map("usuario_id")
  fornecedoraId  String?          @unique @map("fornecedora_id")
  criadoEm       DateTime         @default(now()) @map("criado_em")
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em")
  usuario        Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  fornecedora    Fornecedora?     @relation(fields: [fornecedoraId], references: [id], onDelete: SetNull)
  pecas          PecaProposta[]

  @@index([etapa])
  @@map("candidaturas")
}

enum SituacaoProposta {
  proposta
  recusada
  /// A Salty recebeu a peça e cadastrou no estoque.
  recebida
}

/// Peça oferecida pela candidata ou fornecedora, antes de virar estoque. O
/// preço final é sempre a Salty que define, ao cadastrar a peça.
model PecaProposta {
  id            String           @id @default(cuid())
  candidaturaId String?          @map("candidatura_id")
  fornecedoraId String?          @map("fornecedora_id")
  descricao     String           @db.Text
  /// Nome base da foto na pasta de fotos (como nas peças).
  foto          String           @db.VarChar(191)
  nome          String?          @db.VarChar(160)
  tamanho       String?          @db.VarChar(20)
  marca         String?          @db.VarChar(80)
  genero        Genero?
  conservacao   Conservacao?
  categoriaId   String?          @map("categoria_id")
  situacao      SituacaoProposta @default(proposta)
  /// Peça do estoque criada quando a Salty recebeu esta.
  pecaId        String?          @unique @map("peca_id")
  criadoEm      DateTime         @default(now()) @map("criado_em")
  candidatura   Candidatura?     @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  fornecedora   Fornecedora?     @relation(fields: [fornecedoraId], references: [id], onDelete: Cascade)
  categoria     Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  peca          Peca?            @relation(fields: [pecaId], references: [id], onDelete: SetNull)

  @@index([candidaturaId])
  @@index([fornecedoraId])
  @@map("pecas_propostas")
}

enum SituacaoDevolucao {
  pedida
  devolvida
  cancelada
}

/// Pedido da fornecedora para ter a peça de volta (só 6 meses depois da entrada).
model Devolucao {
  id                 String            @id @default(cuid())
  pecaId             String            @map("peca_id")
  fornecedoraId      String            @map("fornecedora_id")
  situacao           SituacaoDevolucao @default(pedida)
  /// Status da peça antes do pedido, para voltar se a Salty cancelar.
  statusAnterior     StatusPeca        @map("status_anterior")
  naoListadaAnterior Boolean           @default(false) @map("nao_listada_anterior")
  pedidaEm           DateTime          @default(now()) @map("pedida_em")
  concluidaEm        DateTime?         @map("concluida_em")
  peca               Peca              @relation(fields: [pecaId], references: [id], onDelete: Cascade)
  fornecedora        Fornecedora       @relation(fields: [fornecedoraId], references: [id], onDelete: Cascade)

  @@index([situacao])
  @@index([pecaId])
  @@index([fornecedoraId])
  @@map("devolucoes")
}

/// Link de primeiro acesso de uma fornecedora que ainda não tem conta (as
/// importadas do Notion). Só o hash do código fica no banco.
model ConviteFornecedora {
  id            String      @id @default(cuid())
  fornecedoraId String      @map("fornecedora_id")
  codigoHash    String      @unique @map("codigo_hash") @db.VarChar(64)
  expiraEm      DateTime    @map("expira_em")
  usadoEm       DateTime?   @map("usado_em")
  criadoEm      DateTime    @default(now()) @map("criado_em")
  fornecedora   Fornecedora @relation(fields: [fornecedoraId], references: [id], onDelete: Cascade)

  @@index([fornecedoraId])
  @@map("convites_fornecedora")
}

/// Ligação com o Google Drive onde vão as cópias de segurança. Há uma só (id 1).
/// A autorização do Google fica cifrada com a chave do servidor (AUTH_SECRET).
model GoogleDrive {
  id                 Int      @id
  email              String?  @db.VarChar(191)
  autorizacaoCifrada String   @map("autorizacao_cifrada") @db.Text
  pastaId            String?  @map("pasta_id") @db.VarChar(191)
  pastaFotosId       String?  @map("pasta_fotos_id") @db.VarChar(191)
  conectadoEm        DateTime @default(now()) @map("conectado_em")

  @@map("google_drive")
}

enum SituacaoBackup {
  rodando
  ok
  erro
}

/// Cada cópia de segurança feita (pelo agendamento diário ou pelo botão do painel).
model Backup {
  id            String         @id @default(cuid())
  situacao      SituacaoBackup @default(rodando)
  origem        String         @db.VarChar(20)
  arquivo       String?        @db.VarChar(191)
  tamanho       Int?
  noDrive       Boolean        @default(false) @map("no_drive")
  fotosEnviadas Int            @default(0) @map("fotos_enviadas")
  mensagem      String?        @db.Text
  iniciadoEm    DateTime       @default(now()) @map("iniciado_em")
  terminadoEm   DateTime?      @map("terminado_em")

  @@index([iniciadoEm])
  @@map("backups")
}

/// Fotos já copiadas para o Google Drive: só as novas são enviadas a cada dia.
model BackupFoto {
  caminho   String   @id @db.VarChar(191)
  driveId   String   @map("drive_id") @db.VarChar(191)
  enviadaEm DateTime @default(now()) @map("enviada_em")

  @@map("backup_fotos")
}

/// Histórico de alterações: quem mudou o quê (preço, status, dados), quando e por quê.
/// Sem chave estrangeira de propósito: o histórico fica mesmo se o registro sumir.
model Alteracao {
  id         String   @id @default(cuid())
  /// "peca", "fornecedora" ou "cliente".
  tabela     String   @db.VarChar(20)
  registroId String   @map("registro_id") @db.VarChar(191)
  /// Como o registro aparecia na hora (ex.: "F06-00001 · Macacão").
  rotulo     String   @db.VarChar(191)
  campo      String   @db.VarChar(80)
  antes      String?  @db.Text
  depois     String?  @db.Text
  /// Só a administradora vê (custo, repasse, CPF/CNPJ, Pix).
  restrito   Boolean  @default(false)
  usuarioId  String?  @map("usuario_id") @db.VarChar(191)
  /// Nome de quem mudou, como era na hora.
  quem       String   @db.VarChar(191)
  /// De onde veio a mudança (ex.: "Pedido nº 12 pago", "Edição no painel").
  motivo     String?  @db.VarChar(191)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([tabela, registroId, criadoEm])
  @@index([criadoEm])
  @@map("alteracoes")
}
